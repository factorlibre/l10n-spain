<odoo>
    <record id="invoice_form" model="ir.ui.view">
        <field name="name">account.invoice.form.mod390</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//field[@name='fiscal_position_id']" position="after">
                <field name="is_bankrupcy_uncollectible_debt"/>
            </xpath>
        </field>
    </record>

    <record id="invoice_supplier_form" model="ir.ui.view">
        <field name="name">account.invoice.supplier.form.mod390</field>
        <field name="model">account.invoice</field>
        <field name="inherit_id" ref="account.invoice_supplier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='other_info']//field[@name='fiscal_position_id']" position="after">
                <field name="is_bankrupcy_uncollectible_debt"/>
            </xpath>
        </field>
    </record>
</odoo>
